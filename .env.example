# Copy to .env.local and fill in. Never commit .env.local.

# Where the database and card photos are stored.
DATA_DIR=./data

# Random string, 32+ characters. Generate with: npm run secret
SESSION_SECRET=

# Owner password, hashed then base64 encoded. Generate with: npm run set-password
OWNER_PASSWORD_HASH_B64=
# Optional instead of the line above: leave it empty, set a long random
# SETUP_CODE, and create the password on the /setup page the first time.
# (Coolify generates SETUP_CODE automatically, see docs/COOLIFY.md.)
SETUP_CODE=

# Card reading. "auto" (same as "free") reads cards on this server with free
# text recognition and looks players up on Wikidata. No keys needed.
# "sample" returns made-up example cards (for trying the app).
# "anthropic" is an optional paid AI mode, off unless you choose it.
RECOGNITION_MODE=auto
# Only used when RECOGNITION_MODE=anthropic. Leave empty.
ANTHROPIC_API_KEY=

# Public address of the app, like https://cards.example.com
# (https, no slash at the end). Used for sign-in redirects and to accept
# changes sent from that address. Leave empty when trying the app locally.
APP_ORIGIN=

# How many proxies in front of the app add to X-Forwarded-For (0 to 5).
# 0 means the header is not trusted, and sign-in limits treat every visitor
# as one. Check More, Connection check after signing in: "IP used for sign-in
# limits" should be your phone's internet address.
TRUST_PROXY_HOPS=0

# Optional. Name of a header that holds the visitor's address, like
# cf-connecting-ip. When set, sign-in limits use ONLY this header and
# TRUST_PROXY_HOPS is ignored. Set it ONLY when the server can be reached
# solely through the proxy that writes it (for example a Cloudflare Tunnel
# with no open ports). Otherwise anyone can fake it and dodge the limits.
# IPv6 visitors are limited by their /64 network. Empty means off.
CLIENT_IP_HEADER=

# Memory: NODE_OPTIONS cannot be set here (Node reads it before this file).
# The start script sets it, which caps the app's memory.

# Optional. Contact (email or web address) sent to Wikidata with player
# lookups, as Wikimedia asks of automated users. Empty uses the project page.
WIKIDATA_CONTACT=

# Optional alerts. The app can send a short message to your phone when
# someone keeps guessing your password, signs in on a new device, changes
# the password, or when scans keep failing. Use Telegram, Discord, or both.
# Leave these empty to turn alerts off. After setting them, open More and
# tap "Send a test alert".
#
# Telegram:
# 1. In Telegram, start a chat with @BotFather and send /newbot. Pick a name.
#    BotFather replies with a token like 123456789:AAH... Put it below.
# 2. Open a chat with your new bot and send it any message, like "hi".
# 3. In a web browser, open https://api.telegram.org/bot<TOKEN>/getUpdates
#    (put your token in place of <TOKEN>). Find "chat":{"id": and copy the
#    number after it (it can start with a minus sign). Put it below.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
#
# Discord: in your server, open Server Settings, Integrations, Webhooks,
# New Webhook, choose the channel, then Copy Webhook URL and paste it below.
# It starts with https://discord.com/api/webhooks/
ALERT_DISCORD_WEBHOOK_URL=
