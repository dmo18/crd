# Copy to .env.local and fill in. Never commit .env.local.

# Where the database and card photos are stored.
DATA_DIR=./data

# Random string, 32+ characters. Generate with: npm run secret
SESSION_SECRET=

# Owner password, hashed then base64 encoded. Generate with: npm run set-password
OWNER_PASSWORD_HASH_B64=

# AI card recognition. Leave the key empty to run in free sample mode.
ANTHROPIC_API_KEY=
# auto = real AI when a key is set, otherwise sample mode. Or force: sample | anthropic
RECOGNITION_MODE=auto
